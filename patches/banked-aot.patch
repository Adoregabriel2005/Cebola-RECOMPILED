     printf("[cg_flat] wrote %u instruction entries with %u byte-sequence variants (%zu-byte image) to %s/%s_step.{c,h}\n",
            emitted, alternatives, image_size, out_dir, pfx);
 }
+
+/* Profile-guided banked AOT backend. Trace entries are instruction addresses,
+ * not embedded ROM bytes; instruction decoding happens only while generating. */
+void cg_emit_bank_trace(const SmsRom *rom,const GameConfig *cfg,const char *out_dir,const char *trace_path){
+    (void)cfg;CG_MKDIR(out_dir);
+    FILE *t=fopen(trace_path,"r");if(!t){perror(trace_path);exit(1);}
+    static unsigned char seen[16][0xC000];memset(seen,0,sizeof seen);
+    unsigned bank,pc,count=0;
+    while(fscanf(t,"%x %x",&bank,&pc)==2){
+        if(bank>=16 || pc>=0xC000){fprintf(stderr,"bad bank/PC trace entry\n");exit(1);}
+        seen[bank][pc]=1;
+    }fclose(t);
+    char path[600];snprintf(path,sizeof path,"%s/monica_step.h",out_dir);
+    FILE *h=fopen(path,"w");if(!h)exit(1);
+    fprintf(h,"#pragma once\n#include \"sms_runtime.h\"\n#include \"z80_ops.h\"\nvoid monica_step(void);\n");
+    for(unsigned b=0;b<16;b++)fprintf(h,"void monica_bank%02u(void);\n",b);
+    fclose(h);
+    snprintf(path,sizeof path,"%s/monica_step.c",out_dir);FILE *d=fopen(path,"w");if(!d)exit(1);
+    fprintf(d,"#include \"monica_step.h\"\nvoid monica_step(void){ switch(g_z80.pc < 0x400 ? 0 : sms_slot_bank(g_z80.pc)){\n");
+    for(unsigned b=0;b<16;b++)fprintf(d,"case %u: monica_bank%02u();return;\n",b,b);
+    fprintf(d,"default:sms_dispatch_miss(g_z80.pc);return;} }\n");fclose(d);
+    for(unsigned b=0;b<16;b++){
+        snprintf(path,sizeof path,"%s/monica_bank%02u.c",out_dir,b);FILE *o=fopen(path,"w");if(!o)exit(1);
+        fprintf(o,"#include \"monica_step.h\"\n#if defined(_MSC_VER)\n#define AOT_NOINLINE __declspec(noinline)\n#else\n#define AOT_NOINLINE __attribute__((noinline))\n#endif\n");
+        unsigned char chunks[48]={0};
+        /* Bound each native switch to 1 KiB of guest addresses. Very large
+           conservative switches otherwise make optimizer time grow sharply. */
+        for(unsigned chunk=0;chunk<48;chunk++){
+            unsigned first=chunk*0x400,last=first+0x400;
+            for(unsigned a=first;a<last;a++)if(seen[b][a]){chunks[chunk]=1;break;}
+            if(!chunks[chunk])continue;
+            fprintf(o,"static AOT_NOINLINE void bank%02u_chunk%02u(void){ Z80State *s=&g_z80;switch(s->pc){\n",b,chunk);
+            for(unsigned a=first;a<last;a++)if(seen[b][a]){
+                size_t off=rom_z80_to_offset(rom,(uint16_t)a,(int)b);
+                if(off==SIZE_MAX || off>=rom->size)continue;
+                Z80Insn in;if(z80_decode(rom->data+off,rom->size-off,(uint16_t)a,&in)<=0 || in.illegal)continue;
+                fprintf(o,"case 0x%04X: { /* %s */\n",a,in.text);
+                emit_flat_match(o,&in,(uint16_t)a);
+                fprintf(o,"sms_dispatch_miss(s->pc);return;}\n");count++;
+            }
+            fprintf(o,"default:sms_dispatch_miss(s->pc);return;} }\n");
+        }
+        fprintf(o,"void monica_bank%02u(void){ switch(g_z80.pc >> 10){\n",b);
+        for(unsigned chunk=0;chunk<48;chunk++)if(chunks[chunk])fprintf(o,"case %u: bank%02u_chunk%02u();return;\n",chunk,b,chunk);
+        fprintf(o,"default:sms_dispatch_miss(g_z80.pc);return;} }\n");fclose(o);
+    }
+    printf("[bank-aot] %u statically decoded instruction addresses emitted\n",count);
+}

+    h=monica_hash(g_bank,sizeof g_bank,h);
+    h=monica_hash(&g_vdp,sizeof g_vdp,h);
+    h=monica_hash(&g_next_line_cyc,sizeof g_next_line_cyc,h);
+    h=monica_hash(&g_sync_deadline,sizeof g_sync_deadline,h);
+    h=monica_hash(&g_frame,sizeof g_frame,h);
+    h=monica_hash(&g_step_irq_pending,sizeof g_step_irq_pending,h);
+    h=monica_hash(&g_io_control,sizeof g_io_control,h);
+    /* Preserve old save digests when the new console button is idle. */
+    if(g_console_nmi_pending)h=monica_hash(&g_console_nmi_pending,sizeof g_console_nmi_pending,h);
+    if(g_pad1&SMS_PAD_START)h=monica_hash(&g_pad1,sizeof g_pad1,h);
+    h=monica_hash(&g_psg_cyc,sizeof g_psg_cyc,h);
+    FILE *f=tmpfile();
+    if(!f || !psg_save_state(f)){ if(f) fclose(f); return 0; }
+    rewind(f); uint8_t buf[256]; size_t n;
+    while((n=fread(buf,1,sizeof buf,f))>0) h=monica_hash(buf,n,h);
+    fclose(f); return h;

+#include "replay.h"
+bool glue_load_rom_wide(const wchar_t *path){
+    FILE *f=_wfopen(path,L"rb");if(!f)return false;
+    uint8_t *bytes=malloc(MONICA_ROM_SIZE);
+    if(!bytes){fclose(f);return false;}
+    size_t n=fread(bytes,1,MONICA_ROM_SIZE,f);int extra=fgetc(f);fclose(f);
+    if(n!=MONICA_ROM_SIZE || extra!=EOF || monica_crc32(bytes,n)!=MONICA_ROM_CRC){free(bytes);return false;}
+    free(g_rom);g_rom=bytes;g_rom_size=n;return true;
+}
+uint64_t glue_state_hash(void){
